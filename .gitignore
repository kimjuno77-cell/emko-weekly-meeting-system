# ========================================
# 주간회의 시스템 - .gitignore
# ========================================

# 의존성 패키지 (npm install로 재설치 가능)
node_modules/

# 빌드 결과물 (npm run build로 재생성 가능)
dist/
build/

# 환경 변수 (보안상 Git에 올리면 안 됨)
.env
.env.local
.env.*.local

# 로그 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 에디터 설정 파일
.vscode/
.idea/
*.swp
*.swo
*~

# OS 생성 임시 파일
.DS_Store
Thumbs.db
Desktop.ini
*.tmp

# TypeScript 캐시
*.tsbuildinfo
